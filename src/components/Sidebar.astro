---
interface Props {
  home?: boolean;
  activeSection?: string;
  activeProject?: string;
}

const { home = false, activeSection = "hero", activeProject = "" } = Astro.props;
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <span class="explorer-label">EXPLORER</span>
  </div>
  {home ? (
    <nav class="file-tree">
      <div class="folder open" id="portfolio-folder">
        <div class="folder-header" data-folder-toggle>
          <span class="folder-toggle">▼</span>
          <span>PORTFOLIO</span>
        </div>
        <div class="folder-contents">
          <a href="#hero" class={`file ${activeSection === "hero" ? "active" : ""}`} data-section="hero"><span class="file-prefix">-</span><span>README.md</span></a>
          <div class="folder open">
            <div class="folder-header" data-folder-toggle>
              <span class="folder-toggle">▼</span>
              <span>src</span>
            </div>
            <div class="folder-contents">
              <a href="#featured" class={`file ${activeSection === "featured" ? "active" : ""}`} data-section="featured"><span class="file-prefix">-</span><span>featured.js</span></a>
              <a href="#work" class={`file ${activeSection === "work" ? "active" : ""}`} data-section="work"><span class="file-prefix">-</span><span>projects/</span></a>
              <a href="#about" class={`file ${activeSection === "about" ? "active" : ""}`} data-section="about"><span class="file-prefix">-</span><span>about.md</span></a>
              <a href="#experience" class={`file ${activeSection === "experience" ? "active" : ""}`} data-section="experience"><span class="file-prefix">-</span><span>experience.json</span></a>
            </div>
          </div>
          <div class="folder">
            <div class="folder-header" data-folder-toggle>
              <span class="folder-toggle">▶</span>
              <span>.github</span>
            </div>
            <div class="folder-contents">
              <a href="https://github.com/davis-ian" class="file" target="_blank" rel="noopener"><span class="file-prefix">-</span><span>profile</span></a>
            </div>
          </div>
        </div>
      </div>
    </nav>
  ) : (
    <nav class="file-tree">
      <div class="folder open">
        <div class="folder-header" data-folder-toggle>
          <span class="folder-toggle">▼</span>
          <span>PORTFOLIO</span>
        </div>
        <div class="folder-contents">
          <a href="/" class="file"><span class="file-prefix">-</span><span>README.md</span></a>
          <div class="folder open">
            <div class="folder-header" data-folder-toggle>
              <span class="folder-toggle">▼</span>
              <span>projects</span>
            </div>
            <div class="folder-contents">
              <a href="/projects/forma" class={`file ${activeProject === "forma" ? "active" : ""}`}><span class="file-prefix">-</span><span>forma.js</span></a>
              <a href="/projects/media-toolkit" class={`file ${activeProject === "media-toolkit" ? "active" : ""}`}><span class="file-prefix">-</span><span>media-toolkit.js</span></a>
              <a href="/projects/upnext" class={`file ${activeProject === "upnext" ? "active" : ""}`}><span class="file-prefix">-</span><span>upnext.js</span></a>
              <a href="/projects/callsign" class={`file ${activeProject === "callsign" ? "active" : ""}`}><span class="file-prefix">-</span><span>callsign.js</span></a>
              <a href="/projects/minigames" class={`file ${activeProject === "minigames" ? "active" : ""}`}><span class="file-prefix">-</span><span>minigames.js</span></a>
              <a href="/projects/ffmpeg-wa" class={`file ${activeProject === "ffmpeg-wa" ? "active" : ""}`}><span class="file-prefix">-</span><span>ffmpeg-wa.js</span></a>
            </div>
          </div>
        </div>
      </div>
    </nav>
  )}
</aside>
