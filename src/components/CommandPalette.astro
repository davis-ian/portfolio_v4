<div class="command-palette-overlay" id="command-palette" role="dialog" aria-modal="true" aria-labelledby="command-palette-title" aria-describedby="command-palette-description" aria-hidden="true">
  <div class="command-palette" tabindex="-1">
    <div class="command-header">
      <h2 id="command-palette-title" class="command-title">Command Palette</h2>
      <button type="button" class="command-close" id="command-palette-close" aria-label="Close command palette">x</button>
    </div>
    <p id="command-palette-description" class="command-description">Search commands and navigation shortcuts.</p>
    <div class="command-input-wrapper">
      <input
        type="text"
        class="command-input"
        id="command-input"
        placeholder="Type a command or search..."
        autocomplete="off"
      />
    </div>
    <div class="command-list" id="command-list"></div>
  </div>
</div>
