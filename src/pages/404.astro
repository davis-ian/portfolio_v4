---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageShell from "@components/PageShell.astro";
---

<BaseLayout
  title="404 - File Not Found | Ian Davis"
  description="The page you requested could not be found. Navigate back to the portfolio home, projects, or case studies."
  ogTitle="404 - File Not Found"
  ogDescription="The page you requested does not exist. Return to the portfolio and continue browsing."
>
  <PageShell
    activeProject=""
    statusFile="404.js"
    crumbs={[
      { href: "/#hero", label: "~/iandavis" },
      { label: "404.js", active: true },
    ]}
  >
    <section class="hero" id="not-found">
      <div class="terminal-prompt">
        <span class="prompt-user">guest</span>
        <span class="prompt-at">@</span>
        <span class="prompt-host">iandavis</span>
        <span class="prompt-separator">:</span>
        <span class="prompt-path">~</span>
        <span class="prompt-symbol">$</span>
        <span class="prompt-command"> cat 404.js</span>
      </div>
      <div class="hero-header">
        <h1 class="hero-title">404 - File Not Found</h1>
        <p class="hero-subtitle">The requested path does not exist.</p>
      </div>
      <p class="hero-description">
        The page may have moved, been renamed, or never existed. Use one of the links below to get
        back on track.
      </p>
    </section>

    <section class="section">
      <h2 class="section-heading">Recovery Actions</h2>
      <div class="project-list">
        <a href="/" class="project-item">
          <span class="project-prefix">&gt;</span>
          <div class="project-info">
            <span class="project-name">README.md</span>
            <span class="project-meta">Return to homepage</span>
          </div>
          <div class="project-actions"><span class="btn-icon">-&gt;</span></div>
        </a>
        <a href="/#work" class="project-item">
          <span class="project-prefix">&gt;</span>
          <div class="project-info">
            <span class="project-name">projects/</span>
            <span class="project-meta">Browse selected works</span>
          </div>
          <div class="project-actions"><span class="btn-icon">-&gt;</span></div>
        </a>
        <a href="/#case-studies" class="project-item">
          <span class="project-prefix">&gt;</span>
          <div class="project-info">
            <span class="project-name">case-studies/</span>
            <span class="project-meta">Open deep-dive writeups</span>
          </div>
          <div class="project-actions"><span class="btn-icon">-&gt;</span></div>
        </a>
      </div>
    </section>
  </PageShell>
</BaseLayout>
